@model WebApplicationInAspire.Models.ResourceViewModel

@{
    ViewData["Title"] = "Registrer ressurs";
}

<div class="container mt-4">
    <h2>Registrer ny ressurs</h2>

    <form method="post" asp-controller="Resource" asp-action="Register">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Navn:</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Type:</label>
            <input asp-for="Type" class="form-control" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse:</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ContactName" class="form-label">Kontaktperson:</label>
            <input asp-for="ContactName" class="form-control" />
            <span asp-validation-for="ContactName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Telefonnummer:</label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Posisjon (klikk i kartet):</label>
            <div id="map" style="height: 400px; width: 100%; border-radius: 8px;" class="border"></div>
            <span asp-validation-for="Latitude" class="text-danger d-block mt-1"></span>
        </div>

        <!-- Skjulte inputs for koordinater som fylles ut via kartklikk -->
        <input type="hidden" asp-for="Latitude" id="Latitude" />
        <input type="hidden" asp-for="Longitude" id="Longitude" />

        <button type="submit" class="btn btn-primary mt-2">Registrer</button>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script> 

    <script>
        // Oppretter Leaflet-kartet i div-en med id="map", sentrert på Kristiansand/Agder
        var map = L.map('map').setView([58.1467, 7.9956], 13);

        // Henter fliser fra OpenStreetMap
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap-bidragsytere'
        }).addTo(map);

        var marker;

        // Lytter etter klikk på kartet
        map.on('click', function (e) {
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;

            if (marker) {
                marker.setLatLng(e.latlng);
            } else {
                marker = L.marker(e.latlng).addTo(map);
            }

            // Setter koordinatene direkte i de skjulte feltene
            document.getElementById('Latitude').value = lat;
            document.getElementById('Longitude').value = lng;
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}