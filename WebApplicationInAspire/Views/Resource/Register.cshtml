@model WebApplicationInAspire.Models.ResourceViewModel

@{
    ViewData["Title"] = "Registrer ressurs";
}

<h2>Registrer ny ressurs</h2>

<form method="post" asp-controller="Resource" asp-action="Register">

    <div>
        <label asp-for="Name">Navn:</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Type">Type:</label>
        <input asp-for="Type" />
        <span asp-validation-for="Type"></span>
    </div>

    <div>
        <label asp-for="Description">Beskrivelse:</label>
        <input asp-for="Description" />
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <label asp-for="ContactName">Kontaktperson:</label>
        <input asp-for="ContactName" />
        <span asp-validation-for="ContactName"></span>
    </div>

    <div>
        <label asp-for="PhoneNumber">Telefonnummer:</label>
        <input asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber"></span>
    </div>

    <div>
        <label>Posisjon (klikk i kartet):</label>
        <div id="map" style="height: 400px; border: 1px solid black;"></div>
    </div>

    <input type="hidden" asp-for="Latitude" id="Latitude" />
    <input type="hidden" asp-for="Longitude" id="Longitude" />
    <span asp-validation-for="Latitude"></span>

    <br />
    <button type="submit">Registrer</button>

</form>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script> 

    <script>
    // Her Oppretter Leaflet-kartet i div-en med id="map", sentrert på Kristiansand/Agder
    var map = L.map('map').setView([58.1467, 7.9956], 13);

    // Her blir bildene hentet fra OpenStreetMap og legger dem til kartet
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap-bidragsytere'
    }).addTo(map);

    // Holder styr på markøren slik at hvem som helst kan flytte den i stedet for å lage nye
    var marker;

    // Lytter eller ser etter klikk på kartet
    map.on('click', function (e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        // Hvis markøren allerede finnes, flytt den. Ellers, opprett en ny.
        if (marker) {
            marker.setLatLng(e.latlng);
        } else {
            marker = L.marker(e.latlng).addTo(map);
        }

        // Skriver koordinatene inn i de skjulte input-feltene i skjemaet
        document.getElementById('Latitude').value = lat.toString().replace('.', ',');
document.getElementById('Longitude').value = lng.toString().replace('.', ',');
    });
    </script>
}


